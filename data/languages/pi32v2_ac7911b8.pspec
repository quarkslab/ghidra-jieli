<?xml version="1.0" encoding="UTF-8" ?>
<processor_spec>
  <programcounter register="pc" />
  <data_space space="ram" />
  <context_data>
    <context_set space="ram">
      <set name="phase" val="0" />
      <set name="parallel" val="0" />
      <set name="parallel_phase" val="0" />
      <set name="ifblock" val="0" />
      <set name="closebracket" val="0" />
      <set name="reploop" val="0" />
    </context_set>
  </context_data>

  <volatile outputop="write_volatile" inputop="read_volatile">
    <!-- Peripheral Memory-Mapped Registers (LSFR, BSFR, HSFR, PSFR, CSFR) -->
    <range space="ram" first="0x00010000" last="0x0001ffff" />
    <range space="ram" first="0x00020000" last="0x0002ffff" />
    <range space="ram" first="0x00040000" last="0x0004ffff" />
    <range space="ram" first="0x00050000" last="0x0005ffff" />
    <range space="ram" first="0x01ee0000" last="0x01eeffff" />
  </volatile>

  <inferptrbounds>
    <!-- Inform decompiler of valid pointer ranges to prevent treating memory addresses as scalar integers -->
    <range space="ram" first="0x00010000" last="0x0005ffff" />
    <range space="ram" first="0x01c00000" last="0x01c80000" />
    <range space="ram" first="0x01ee0000" last="0x01eeffff" />
    <range space="ram" first="0x01f20000" last="0x01f40000" />
    <range space="ram" first="0x02000000" last="0x02800000" />
    <range space="ram" first="0x04000000" last="0x04200000" />
    <range space="ram" first="0x08000000" last="0x0c000000" />
  </inferptrbounds>

  <default_memory_blocks>
    <!-- AC7911B8 System Memory Architecture -->
    <!-- Flash Memory: 8 MBytes (64 MBit SPI NorFlash mapped via SFC) -->
    <memory_block name="FLASH" start_address="ram:0x02000000" length="0x800000" mode="rx" initialized="false" />
    <!-- Internal System SRAM: 512 KBytes (0x01c00000 to 0x01c80000) -->
    <memory_block name="SRAM" start_address="ram:0x01c00000" length="0x80000" mode="rwx" initialized="false" />
    <!-- Cache RAM / Scratchpad -->
    <memory_block name="CACHE_RAM" start_address="ram:0x01f20000" length="0x20000" mode="rw" initialized="false" />
    <!-- SDRAM Space (internal 2MB or external up to 32MB) -->
    <memory_block name="SDRAM" start_address="ram:0x04000000" length="0x200000" mode="rwx" initialized="false" />
    <!-- Core SFR Space (CSFR) -->
    <memory_block name="CSFR" start_address="ram:0x01ee0000" length="0x10000" mode="rw" initialized="false" />
    <!-- Low-Speed Peripheral SFRs (LSFR: Clock, Timers, UART, SPI, SD, SHA, USB, Audio) -->
    <memory_block name="LSFR" start_address="ram:0x00010000" length="0x10000" mode="rw" initialized="false" />
    <!-- Wireless / Bluetooth Baseband SFRs (BSFR) -->
    <memory_block name="BSFR" start_address="ram:0x00020000" length="0x10000" mode="rw" initialized="false" />
    <!-- High-Speed Peripheral SFRs (HSFR: SFC, SDR, PSRAM, JPG, Video ISC, Display IMD) -->
    <memory_block name="HSFR" start_address="ram:0x00040000" length="0x10000" mode="rw" initialized="false" />
    <!-- Port / GPIO Peripheral SFRs (PSFR: GPIO Port A-H, Wakeup, IOMAP) -->
    <memory_block name="PSFR" start_address="ram:0x00050000" length="0x10000" mode="rw" initialized="false" />
  </default_memory_blocks>

  <default_symbols>
    <!-- Interrupt Vector Table (128 vectors at 0x01c7fe00) -->
    <symbol name="vector_SDTAP" address="ram:0x01c7fe00" entry="true" type="code" />
