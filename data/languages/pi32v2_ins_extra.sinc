#############################################################################
# PI32V2 Extra Instructions: System, Got, Move, Shift/Round, Stack & Branches
#############################################################################

# COPEXw_ddi: edregA = copex(edregC) (imm)
:copex edregA, edregC, imm1623 is group=7 & ins0011=0x1ff ; edregA & imm2828=0 & edregC & imm1623
{
    local imm:4 = imm1623;
    edregA = CoprocessorExecute(edregC, imm);
}

# LDGOTw_rr: eregA = [npc + eregC]
:eregA = ["npc" + eregC] is group=7 & ins0012=0x860 ; eregA & eregC & imm1623=0
{
    eregA = *:4 (inst_next + eregC);
}

# LDGOTx_ri: regA = [npc + imm32]
:regA = ["npc" + imm32] is group=7 & ins0412=0x1fa & regA ; imm1616=0 & imm1631 ; imm3247
[ imm32 = imm1631 | (imm3247 << 16); ]
{
    local off:4 = imm32;
    regA = *:4 (inst_next + off);
}

# MOVEZw_bi: eregA.b0 = imm8
:mov eregA[0,8], imm1623 is group=7 & ins0011=0x20 ; eregA & imm2425=0 & imm1623
{
    eregA = (eregA & 0xffffff00) | imm1623;
}

# MOVEw_hh: Halfword register moves
:mov eregA[0,16], eregC[0,16] is group=7 & ins0011=0x68 ; eregA & eregC & imm2223=0 & imm1621=0
{
    eregA = (eregA & 0xffff0000) | (eregC & 0x0000ffff);
}

:mov eregA[0,16], eregC[16,16] is group=7 & ins0011=0x68 ; eregA & eregC & imm2223=1 & imm1621=0
{
    eregA = (eregA & 0xffff0000) | (eregC >> 16);
}

:mov eregA[16,16], eregC[0,16] is group=7 & ins0011=0x68 ; eregA & eregC & imm2223=2 & imm1621=0
{
    eregA = (eregA & 0x0000ffff) | ((eregC & 0x0000ffff) << 16);
}

:mov eregA[16,16], eregC[16,16] is group=7 & ins0011=0x68 ; eregA & eregC & imm2223=3 & imm1621=0
{
    eregA = (eregA & 0x0000ffff) | (eregC & 0xffff0000);
}

# CSHFw_rrr & CSHFSw_rrr
:cshf eregA, eregB, eregC is group=7 & ins0011=0x1cc ; eregA & eregC & eregB & imm1619=2
{
    eregA = CircularShift(eregB, eregC);
}

:cshfs eregA, eregB, eregC is group=7 & ins0011=0x1cc ; eregA & eregC & eregB & imm1619=3
{
    eregA = CircularShift(eregB, eregC);
}

# CSHFw_dr & CSHFSw_dr
:cshf edregA, eregC is group=7 & ins0011=0x1dc ; edregA & imm2828=0 & eregC & imm2023=0 & imm1619=2
{
    edregA = CircularShift(edregA, eregC);
}

:cshfs edregA, eregC is group=7 & ins0011=0x1dc ; edregA & imm2828=0 & eregC & imm2023=0 & imm1619=3
{
    edregA = CircularShift(edregA, eregC);
}

:shfdr.upz eregA, edregB, imm1621 is group=7 & ins0011=0x1d2 ; eregA & imm2627=0 & imm2020=0 & edregB & imm1621
{
    local imm:4 = imm1621;
    eregA = ShiftAndRound(edregB, imm);
}

