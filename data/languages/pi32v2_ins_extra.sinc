{
    local imm:4 = imm1621;
    eregA = ShiftAndRound(edregB, imm);
}

:shfdr.rounds eregA, edregB, imm1621 is group=7 & ins0011=0x1d2 ; eregA & imm2627=3 & imm2020=0 & edregB & imm1621
{
    local imm:4 = imm1621;
    eregA = ShiftAndRound(edregB, imm);
}

:shfdr.zeros eregA, edregB, imm1621 is group=7 & ins0011=0x1d2 ; eregA & imm2627=3 & imm2020=1 & edregB & imm1621
{
    local imm:4 = imm1621;
    eregA = ShiftAndRound(edregB, imm);
}

:shfdr_0 eregA, edregB, eregC is group=7 & ins0011=0x1d3 ; eregA & edregB & eregC & imm1620=0
{
    eregA = ShiftAndRound(edregB, eregC);
}

