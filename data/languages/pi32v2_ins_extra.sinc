    local imm:4 = imm1621;
    eregA = ShiftAndRound(edregB, imm);
}

:shfdr.ups eregA, edregB, imm1621 is group=7 & ins0011=0x1d2 ; eregA & imm2627=2 & imm2020=0 & edregB & imm1621
{
    local imm:4 = imm1621;
    eregA = ShiftAndRound(edregB, imm);
