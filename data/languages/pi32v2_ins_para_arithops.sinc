# Parallelized arithmetics operations

###########################################################################################
# Subtract
###########################################################################################

#
# rA = rB - rC
# => sub rA, rB, rC
#
:sub regAl, regBl, regCxl is group=6 & ins0912=0xF & regAl & regBl & regCxl
{
	regAl = regBl - regCxl;
}