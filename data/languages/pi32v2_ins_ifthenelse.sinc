#
# iff (rA > rB) then { ... } else { ... }
#
:iff (regA > eregC) { is group=7 & ins0411=0xE1 & regA ; eregC & imm1623=0x80 & ifcnt & elsecnt
[
    thenbranch=ifcnt+1; globalset(inst_next, thenbranch);
    elsebranch=elsecnt; globalset(inst_next, elsebranch);
    ifblock=1; globalset(inst_next, ifblock);
]
{
    if (regA f<= eregC) goto <else>;
    cres=1;
    goto <end>;

<else>
    cres=0;
<end>
}

