##################
#
# Shift/Rotate
#
##################

# TODO: if immediate shamt is 0 then it's 32 or 64, if we're doing it with doubled registers

###########################################################################################
# Logical shift left
###########################################################################################

#
# rA <<= rB
# => lsl rA, rB
#
:lsl regAl, regBl is group=0 & ins0712=0x34 & ins0303=0 & regAl & regBl
{
	regAl = regAl << regBl;
}

# 
# rA = rB << shamt
# => lsl rA, rB, shamt
#
:lsl regAl, regBl, imm0812 is group=5 & ins0707=0 & ins0303=0 & regAl & regBl & imm0812
{
	regAl = regBl << imm0812;
}

# 
# rA = rC >> rB (r0 to r15)
# => lsr rA, rB, rC
:lsl eregA, eregB, eregC is group=7 & ins0011=0x1c8 ; eregA & eregC & eregB & imm1619=0
{
	eregA = eregB << eregC;
}

# 
# rA = rC << rB (r0 to r15)
# => lsl rA, rB, rC
:lsl eregA, eregB, eregC is group=7 & ins0011=0x1c8 ; eregA & eregC & eregB & imm1619=1
{
	eregA = eregB << eregC;
}

#
# rA = rB << #imm6
# => lsl rA, rB, imm6
:lsl eregA, eregB, imm6 is group=7 & ins0011=0x1c0 ; eregA & eregB & imm2627=0 & imm2425 & imm1619
[imm6 = (imm2425 << 4) | imm1619;]
{
    eregA = eregB << imm6;
}

###########################################################################################
# Logical shift right
###########################################################################################

#
# rA >>= rB
# => lsr rA, rB
#
:lsr regAl, regBl is group=0 & ins0712=0x35 & ins0303=0 & regAl & regBl
{
	regAl = regAl >> regBl;
}

# 
# rA = rC >> rB (r0 to r15)
# => lsr rA, rB, rC
:lsr eregA, eregB, eregC is group=7 & ins0011=0x1c8 ; eregA & eregC & eregB & imm1619=2
{
	eregA = eregB >> eregC;
}

#
# rA = rB >> shamt
# => lsr rA, rB, shamt
#
:lsr regAl, regBl, imm0812 is group=5 & ins0707=1 & ins0303=0 & regAl & regBl & imm0812
{
	regAl = regBl >> imm0812;
}

#
# rA = rB >> imm6
# => lsl rA, rB, imm6
:lsl eregA, eregB, imm6 is group=7 & ins0011=0x1c0 ; eregA & eregB & imm2627=2 & imm2425 & imm1619
[imm6 = (imm2425 << 4) | imm1619;]
{
    eregA = eregB >> imm6;
}

#
# rA_rB <<= #imm6
#
:lsl edregA, #imm6 is group=7 & ins0011=0x1d0 ; edregA & imm2627=0 & eregB=0 & imm1619 & imm2425
[ imm6 = (imm2425 << 4) | imm1619; ]
{
    edregA = edregA << imm6;
}

#
# rA_rB >>= #imm6
#
:lsr edregA, #imm6 is group=7 & ins0011=0x1d0 ; edregA & imm2627=2 & eregB=0 & imm1619 & imm2425
[ imm6 = (imm2425 << 4) | imm1619; ]
{
    edregA = edregA >> imm6;
}

#
# rA_rB >>>= #imm6
#
:qasr edregA, #imm6 is group=7 & ins0011=0x1d0 ; edregA & imm2627=3 & eregB=0 & imm1619 & imm2425
[ imm6 = (imm2425 << 4) | imm1619; ]
{
    edregA = edregA s>> imm6;
}

###########################################################################################
# (Q) Arithmetic shift left
###########################################################################################

### TODO: overflow? ###

#
# rA <<<= rB
# => qasl rA, rB
#
:qasl regAl, regBl is group=0 & ins0712=0x34 & ins0303=1 & regAl & regBl
{
	regAl = regAl << regBl;
}

#
# rA = rB <<< shamt
# => qasl rA, rB, shamt
#
:qasl regAl, regBl, imm0812 is group=5 & ins0707=0 & ins0303=1 & regAl & regBl & imm0812
{
	regAl = regBl << imm0812;
}

#
# rA = rB <<< imm6
# => qasl rA, rB, imm6
:qasl eregA, eregB, imm6 is group=7 & ins0011=0x1c0 ; eregA & eregB & imm2627=1 & imm2425 & imm1619
[imm6 = (imm2425 << 4) | imm1619;]
{
    eregA = eregB << imm6;
}

###########################################################################################
# (Q) Arithmentic shift right
###########################################################################################

#
# rA >>>= rB
# => qasr rA, rB
#
:qasr regAl, regBl is group=0 & ins0712=0x35 & ins0303=1 & regAl & regBl
{
	regAl = regAl s>> regBl;
}

#
# rA = rB >>> shamt
# => qasr rA, rB, shamt
#
:qasr regAl, regBl, imm0812 is group=5 & ins0707=1 & ins0303=1 & regAl & regBl & imm0812
{
	regAl = regBl s>> imm0812;
}

# 
# rA = rC >> rB (r0 to r15)
# => lsr rA, rB, rC
:qasr eregA, eregB, eregC is group=7 & ins0011=0x1c8 ; eregA & eregC & eregB & imm1619=3
{
	eregA = eregB s>> eregC;
}

#
# rA = rB >>> imm6
# => qasr rA, rB, imm6
:qasr eregA, eregB, imm6 is group=7 & ins0011=0x1c0 ; eregA & eregB & imm2627=3 & imm2425 & imm1619
[imm6 = (imm2425 << 4) | imm1619;]
{
    eregA = eregB s>> imm6;
}

#
# rA_rB <<= rC
#
:lsl edregA, eregC is group=7 & ins0011=0x1d8 ; edregA & eregB=0 & eregC & imm1619=0
{
    edregA = edregA << eregC;
}

#
# rA_rB >>= rC
#
:lsr edregA, eregC is group=7 & ins0011=0x1d8 ; edregA & eregB=0 & eregC & imm1619=2
{
    edregA = edregA >> eregC;
}

#
# rA_rB >>>= rC
#
:qasr edregA, eregC is group=7 & ins0011=0x1d8 ; edregA & eregB=0 & eregC & imm1619=3
{
    edregA = edregA s>> eregC;
}



###########################################################################################
# Logical shift left + right (used for alignment)
###########################################################################################

#
# rA = rB <> #imm6
#
:lslr eregA, eregB, #imm6 is group=7 & ins0011=0x1c4 ; eregA & eregB & imm2425 & imm1619
[imm6 = (imm2425 << 4) | imm1619;]
{
    eregA = (eregB << imm6) >> imm6;
}

###########################################################################################
# Memory shift operations
###########################################################################################

shamt4_32: "32" is imm2427=0 { local c:4 = 32; export c; }
shamt4_32: imm2427 is imm2427 { local c:4 = imm2427; export c; }

shamt16_31: imm is imm2427 [ imm = 16 | imm2427; ] { local c:4 = imm; export c; }

#
# [rA+offset] <<= shamt
#
:lsl [eregA+offset], shamt4_32 is group=7 & ins0011=0x86c ; eregA & shamt4_32 & imm1823s & imm1617=0
[ offset = imm1823s << 2; ]
{
    addr:4 = eregA + offset;
    *:4 addr = *:4 addr << shamt4_32;
}

:lsl [eregA+offset], shamt16_31 is group=7 & ins0011=0x86d ; eregA & shamt16_31 & imm1823s & imm1617=0
[ offset = imm1823s << 2; ]
{
    addr:4 = eregA + offset;
    *:4 addr = *:4 addr << shamt16_31;
}

#
# [rA+offset] <<<= shamt
#
:qasl [eregA+offset], shamt4_32 is group=7 & ins0011=0x86c ; eregA & shamt4_32 & imm1823s & imm1617=1
[ offset = imm1823s << 2; ]
{
    addr:4 = eregA + offset;
    *:4 addr = *:4 addr << shamt4_32;
}

:qasl [eregA+offset], shamt16_31 is group=7 & ins0011=0x86d ; eregA & shamt16_31 & imm1823s & imm1617=1
[ offset = imm1823s << 2; ]
{
    addr:4 = eregA + offset;
    *:4 addr = *:4 addr << shamt16_31;
}

#
# [rA+offset] >>= shamt
#
:lsr [eregA+offset], shamt4_32 is group=7 & ins0011=0x86c ; eregA & shamt4_32 & imm1823s & imm1617=2
[ offset = imm1823s << 2; ]
{
    addr:4 = eregA + offset;
    *:4 addr = *:4 addr >> shamt4_32;
}

:lsr [eregA+offset], shamt16_31 is group=7 & ins0011=0x86d ; eregA & shamt16_31 & imm1823s & imm1617=2
[ offset = imm1823s << 2; ]
{
    addr:4 = eregA + offset;
    *:4 addr = *:4 addr >> shamt16_31;
}

#
# [rA+offset] >>>= shamt
#
:qasr [eregA+offset], shamt4_32 is group=7 & ins0011=0x86c ; eregA & shamt4_32 & imm1823s & imm1617=3
[ offset = imm1823s << 2; ]
{
    addr:4 = eregA + offset;
    *:4 addr = *:4 addr s>> shamt4_32;
}

:qasr [eregA+offset], shamt16_31 is group=7 & ins0011=0x86d ; eregA & shamt16_31 & imm1823s & imm1617=3
[ offset = imm1823s << 2; ]
{
    addr:4 = eregA + offset;
    *:4 addr = *:4 addr s>> shamt16_31;
}

###########################################################################################
# Memory shift operations by register
###########################################################################################

#
# [rA+offset] <<= rB  (memory shift left by register)
#
:lsl [eregA+offset], eregC is group=7 & ins0011=0x86e ; eregA & eregC & imm1823s & imm1617=0
[ offset = imm1823s << 2; ]
{
    addr:4 = eregA + offset;
    *:4 addr = *:4 addr << eregC;
}

#
# [rA+offset] <<<= rB  (memory arithmetic shift left by register)
#
:qasl [eregA+offset], eregC is group=7 & ins0011=0x86e ; eregA & eregC & imm1823s & imm1617=1
[ offset = imm1823s << 2; ]
{
    addr:4 = eregA + offset;
    *:4 addr = *:4 addr << eregC;
}

#
# [rA+offset] >>= rB  (memory shift right by register)
#
:lsr [eregA+offset], eregC is group=7 & ins0011=0x86e ; eregA & eregC & imm1823s & imm1617=2
[ offset = imm1823s << 2; ]
{
    addr:4 = eregA + offset;
    *:4 addr = *:4 addr >> eregC;
}

#
# [rA+offset] >>>= rB  (memory arithmetic shift right by register)
#
:qasr [eregA+offset], eregC is group=7 & ins0011=0x86e ; eregA & eregC & imm1823s & imm1617=3
[ offset = imm1823s << 2; ]
{
    addr:4 = eregA + offset;
    *:4 addr = *:4 addr s>> eregC;
}

###########################################################################################
# Rotate operations (register-register)
###########################################################################################

#
# rA = rB <> rC  (rotate right by register)
#
:ror eregA, eregB, eregC is group=7 & ins0011=0x1cc ; eregA & eregC & eregB & imm1619=0
{
    local shamt:4 = eregC & 0x1f;
    eregA = (eregB >> shamt) | (eregB << (32 - shamt));
}

#
# rA = rB <c> rC  (rotate right through carry by register)
#
:rorc eregA, eregB, eregC is group=7 & ins0011=0x1cc ; eregA & eregC & eregB & imm1619=1
{
    local shamt:4 = eregC & 0x1f;
    local c:4 = zext($(C));
    local val:8 = (zext(eregB) << 1) | zext(c);
    val = (val >> shamt) | (val << (33 - shamt));
    $(C) = val[0,1];
    eregA = val[1,32];
}

###########################################################################################
# 64-bit pair shift operations
###########################################################################################

shamt6_64: "64" is imm1621=0 { local c:4 = 64; export c; }
shamt6_64: imm1621 is imm1621 { local c:4 = imm1621; export c; }

#
# rD <<<= imm6 (64-bit pair arithmetic shift left immediate)
#
:qasl edregA, shamt6_64 is group=7 & ins0011=0x1d0 ; edregA & imm2227=0x10 & shamt6_64
{
    local s:4 = shamt6_64;
    edregA = edregA << s;
}

#
# rD <>= imm6 (64-bit pair rotate right immediate)
#
:ror edregA, shamt6_64 is group=7 & ins0011=0x1d4 ; edregA & imm2227=0x00 & shamt6_64
{
    local s:8 = zext(shamt6_64 & 0x3f);
    if (s == 0) goto <done>;
    edregA = (edregA >> s) | (edregA << (64 - s));
<done>
}

#
# rD <c>= imm6 (64-bit pair rotate right through carry immediate)
#
:rorc edregA, shamt6_64 is group=7 & ins0011=0x1d4 ; edregA & imm2227=0x20 & shamt6_64
{
    local s:8 = zext(shamt6_64 & 0x3f);
    if (s == 0) goto <done>;
    local val:8 = edregA;
    $(C) = val[0,1];
    edregA = (val >> s) | (val << (64 - s));
<done>
}

#
# rD <<<= rC (64-bit pair arithmetic shift left by register)
#
:qasl edregA, eregC is group=7 & ins0011=0x1d8 ; edregA & eregC & imm1619=1
{
    local s:4 = eregC & 0x3f;
    edregA = edregA << s;
}

#
# rD <>= rC (64-bit pair rotate right by register)
#
:ror edregA, eregC is group=7 & ins0011=0x1dc ; edregA & eregC & imm1619=0
{
    local s:8 = zext(eregC & 0x3f);
    if (s == 0) goto <done>;
    edregA = (edregA >> s) | (edregA << (64 - s));
<done>
}

#
# rD <c>= rC (64-bit pair rotate right through carry by register)
#
:rorc edregA, eregC is group=7 & ins0011=0x1dc ; edregA & eregC & imm1619=1
{
    local s:8 = zext(eregC & 0x3f);
    if (s == 0) goto <done>;
    local val:8 = edregA;
    $(C) = val[0,1];
    edregA = (val >> s) | (val << (64 - s));
<done>
}