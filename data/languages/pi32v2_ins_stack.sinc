# Push 16-bit special registers subtable
pshsregset16: "{}" is imm0005=0 {  }
pshsregset16: "{reti}" is imm0005=1 { pushreg(reti);  }
pshsregset16: "{rete}" is imm0005=2 { pushreg(rete);  }
pshsregset16: "{rete, reti}" is imm0005=3 { pushreg(rete); pushreg(reti);  }
