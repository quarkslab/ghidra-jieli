pshsregset16: "{psr, rets, retx}" is imm0005=44 { pushreg(psr); pushreg(rets); pushreg(retx);  }
pshsregset16: "{psr, rets, retx, reti}" is imm0005=45 { pushreg(psr); pushreg(rets); pushreg(retx); pushreg(reti);  }
pshsregset16: "{psr, rets, retx, rete}" is imm0005=46 { pushreg(psr); pushreg(rets); pushreg(retx); pushreg(rete);  }
pshsregset16: "{psr, rets, retx, rete, reti}" is imm0005=47 { pushreg(psr); pushreg(rets); pushreg(retx); pushreg(rete); pushreg(reti);  }
pshsregset16: "{psr, sr4}" is imm0005=48 { pushreg(psr); pushreg(sr4);  }
pshsregset16: "{psr, sr4, reti}" is imm0005=49 { pushreg(psr); pushreg(sr4); pushreg(reti);  }
pshsregset16: "{psr, sr4, rete}" is imm0005=50 { pushreg(psr); pushreg(sr4); pushreg(rete);  }
pshsregset16: "{psr, sr4, rete, reti}" is imm0005=51 { pushreg(psr); pushreg(sr4); pushreg(rete); pushreg(reti);  }
pshsregset16: "{psr, sr4, retx}" is imm0005=52 { pushreg(psr); pushreg(sr4); pushreg(retx);  }
pshsregset16: "{psr, sr4, retx, reti}" is imm0005=53 { pushreg(psr); pushreg(sr4); pushreg(retx); pushreg(reti);  }
pshsregset16: "{psr, sr4, retx, rete}" is imm0005=54 { pushreg(psr); pushreg(sr4); pushreg(retx); pushreg(rete);  }
pshsregset16: "{psr, sr4, retx, rete, reti}" is imm0005=55 { pushreg(psr); pushreg(sr4); pushreg(retx); pushreg(rete); pushreg(reti);  }
pshsregset16: "{psr, sr4, rets}" is imm0005=56 { pushreg(psr); pushreg(sr4); pushreg(rets);  }
pshsregset16: "{psr, sr4, rets, reti}" is imm0005=57 { pushreg(psr); pushreg(sr4); pushreg(rets); pushreg(reti);  }
pshsregset16: "{psr, sr4, rets, rete}" is imm0005=58 { pushreg(psr); pushreg(sr4); pushreg(rets); pushreg(rete);  }
pshsregset16: "{psr, sr4, rets, rete, reti}" is imm0005=59 { pushreg(psr); pushreg(sr4); pushreg(rets); pushreg(rete); pushreg(reti);  }
pshsregset16: "{psr, sr4, rets, retx}" is imm0005=60 { pushreg(psr); pushreg(sr4); pushreg(rets); pushreg(retx);  }
pshsregset16: "{psr, sr4, rets, retx, reti}" is imm0005=61 { pushreg(psr); pushreg(sr4); pushreg(rets); pushreg(retx); pushreg(reti);  }
pshsregset16: "{psr, sr4, rets, retx, rete}" is imm0005=62 { pushreg(psr); pushreg(sr4); pushreg(rets); pushreg(retx); pushreg(rete);  }
pshsregset16: "{psr, sr4, rets, retx, rete, reti}" is imm0005=63 { pushreg(psr); pushreg(sr4); pushreg(rets); pushreg(retx); pushreg(rete); pushreg(reti);  }

#
# {sregs...} = [sp++]
# => pop {sregs...}
#
:pop popsregset16 is group=0 & ins0612=0x12 & imm0005 & popsregset16
{
    mult_addr = sp;
    build popsregset16;
    sp = mult_addr;
}

#
# [--sp] = {sregs...}
# => push {sregs...}
#
:push pshsregset16 is group=0 & ins0612=0x13 & imm0005 & pshsregset16
{
    mult_addr = sp;
    build pshsregset16;
    sp = mult_addr;
}

#
# {pc, regs...} = [sp++]
# => pop {pc, regs...}
#
:pop poppcregs is group=0 & ins0412=0x045 & ins0003 & poppcregs
{
    mult_addr = sp;
    build poppcregs;
    sp = mult_addr;
}

#
# [--sp] = {...regs, r3}
# => push {...regs, r3}
#
:push {pushreglist3} is group=0 & ins0412=0x046 & ins0003>0 & ins0003 & pushreglist3
[ counter = ins0003 & 0xf; ]
{
    mult_addr = sp;
    build pushreglist3;
    sp = mult_addr;
}

#
# [--sp] = {rets, r4, ...}
# => push {rets, r4, ...}
#
:push pshretsregs is group=0 & ins0412=0x047 & ins0003>=4 & pshretsregs
{
    mult_addr = sp;
    build pshretsregs;
    sp = mult_addr;
}

#
# [--sp] = {reg, ...}
# => push {reg, ...}
#
:push {pshmap} is group=7 & ins0011=0x8D8 ; pshmap
{
    mult_addr = sp;
    build pshmap;
    sp = mult_addr;
}

#
# {reg, ...} = [sp++]
# => pop {reg, ...}
#
:pop {popmap} is group=7 & ins0011=0x8D4 ; popmap
{
    mult_addr = sp;
    build popmap;
    sp = mult_addr;
}

#
# [--sp] = {rets, reg, ...}
# => push {rets, reg, ...}
#
:push {rets, pshmap} is group=7 & ins0011=0x8D9 & rets ; pshmap
{
    mult_addr = sp;
    pushreg(rets);
    build pshmap;
    sp = mult_addr;
}

#
# {rets, reg, ...} = [sp++]
# => pop {rets, reg, ...}
#
:pop {pc, popmap} is group=7 & ins0011=0x8D5 & pc ; popmap
{
    mult_addr = sp;
    build popmap;
    popreg(pc);
    sp = mult_addr;
    return [pc];
}

#
# [--sp] = {sregs}
# => push {sregs}
#
:push {pshsrmap} is group=7 & ins0011=0x958 ; pshsrmap
{
    mult_addr = sp;
    build pshsrmap;
    sp = mult_addr;
}

#
# {sregs} = [sp++]
# => pop {sregs}
#
:pop {popsrmap} is group=7 & ins0011=0x950 ; popsrmap
{
    mult_addr = sp;
    build popsrmap;
    sp = mult_addr;
}

###########################################################################################
# Load/Store Multiple to General Pointer Registers
###########################################################################################

#
# {regs...} = [rA++] (LMIA)
#
:lmia regA, {popmap} is group=7 & ins0411=0xb1 & regA ; popmap
{
    mult_addr = regA;
    build popmap;
    regA = mult_addr;
}

#
# [rA++] = {regs...} (SMIA)
#
:smia regA, {pshmap} is group=7 & ins0411=0xb3 & regA ; pshmap
{
    mult_addr = regA;
    build pshmap;
    regA = mult_addr;
}

#
# {regs...} = [-rA] (LMD)
#
:lmd regA, {popmap} is group=7 & ins0411=0xb4 & regA ; popmap
{
    mult_addr = regA;
    build popmap;
    regA = mult_addr;
}

#
# {regs...} = [--rA] (LMDB)
#
:lmdb regA, {popmap} is group=7 & ins0411=0xb5 & regA ; popmap
{
    mult_addr = regA;
    build popmap;
    regA = mult_addr;
}

#
# [-rA] = {regs...} (SMD)
#
:smd regA, {pshmap} is group=7 & ins0411=0xb6 & regA ; pshmap
{
    mult_addr = regA;
    build pshmap;
    regA = mult_addr;
}

#
# [--rA] = {regs...} (SMDB)
#
:smdb regA, {pshmap} is group=7 & ins0411=0xb7 & regA ; pshmap
{
    mult_addr = regA;
    build pshmap;
    regA = mult_addr;
}

#
# [sp] = rA
# => sw rA, [sp]
#
:sw regA, ["sp"] is group=1 & ins0707=1 & ins0606=0 & imm0505=0 & ins0404=0 & regA & imm0812=0
{
    *:4 sp = regA;
}

#
# [sp+imm6] = rA
# => sw rA, [sp+imm6]
#
:sw regA, ["sp"+imm6] is group=1 & ins0707=1 & ins0606=0 & imm0505=0 & ins0404=0 & regA & imm0812>0 & imm0812
[ imm6 = imm0812 * 4; ]
{
    addr:4 = sp + imm6;
    *:4 addr = regA;
}

:sw regA, ["sp"+imm6] is group=1 & ins0707=1 & ins0606=0 & imm0505=1 & ins0404=0 & regA & imm0812
[ imm6 = ((1 << 5) | imm0812) * 4; ]
{
    addr:4 = sp + imm6;
    *:4 addr = regA;
}

#
# [sp+imm12] = rA
# => sw rA, [sp+imm12]
#
:sw eregA, ["sp"+imm12] is group=7 & ins0011=0x9d4 ; eregA & imm1617=1 & imm1827
[ imm12 = imm1827 << 2; ]
{
    local addr:4 = sp + imm12;
    *:4 addr = eregA;
}

#
# rA = [sp+#imm6]
# => lw rA, [sp+imm6]
#
:lw regA, ["sp"+imm6] is group=1 & ins0707=0 & ins0606=0 & imm0505=0 & ins0404=0 & regA & imm0812>0 & imm0812
[ imm6 = imm0812 * 4; ]
{
    local addr:4 = sp + imm6;
    regA = *:4 addr;
}

:lw regA, ["sp"+imm6] is group=1 & ins0707=0 & ins0606=0 & imm0505=1 & ins0404=0 & regA & imm0812
[ imm6 = ((1 << 5) | imm0812) * 4; ]
{
    local addr:4 = sp + imm6;
    regA = *:4 addr;
}

#
# rA = [sp+imm12]
# => lw rA, [sp+imm12]
#
:lw eregA, ["sp"+imm12] is group=7 & ins0011=0x9d4 ; eregA & imm1617=0 & imm1827
[ imm12 = imm1827 << 2; ]
{
    local addr:4 = sp + imm12;
    eregA = *:4 addr;
}

#
# d[sp+imm12] = rB_rA
# => sdw rB_rA, [sp+imm12]
#
:sdw edregA, ["sp"+imm12] is group=7 & ins0011=0x9d0 ; edregA & imm1617=1 & imm1827
[ imm12 = imm1827 << 2; ]
{
    local addr:4 = sp + imm12;
    *:8 addr = edregA;
}

#
# h[sp+imm12] = rA
# => sh rA, [sp+imm12]
#
:sh eregA, ["sp"+imm12] is group=7 & ins0011=0x9d8 ; eregA & imm1616=1 & imm1727
[ imm12 = (imm1727 << 1); ]
{
    local addr:4 = sp + imm12;
    *:2 addr = eregA:2;
}

#
# b[sp+imm12] = rA
# => sb rA, [sp+imm12]
#
:sb eregA, ["sp"+imm1627] is group=7 & ins0011=0x9de ; eregA & imm1627
{
    local addr:4 = sp + imm1627;
    *:1 addr = eregA:1;
}

#
# rA = b[sp+imm12] (s)
# => lb.s rA, [sp+imm12] (signed)
#
:lb.s eregA, ["sp"+imm1627] is group=7 & ins0011=0x9dd ; eregA & imm1627
{
    local addr:4 = sp + imm1627;
    eregA = sext(*:1 addr);
}


#
# rB_rA = d[sp+imm12]
# => ldw rB_rA, [sp+imm12]
#
:ldw edregA, ["sp"+imm12] is group=7 & ins0011=0x9d0 ; edregA & imm1617=0 & imm1827
[ imm12 = imm1827 << 2; ]
{
    local addr:4 = sp + imm12;
    edregA = *:8 addr;
}

#
# rA = [sp+#imm5]
# => lw rA, [sp+imm5]
#
:lw regA, ["sp"] is group=1 & ins0707=0 & ins0606=0 & imm0505=0 & ins0404=0 & regA & imm0812=0
{
    regA = *:4 sp;
}


#
# rA = h[sp+imm12] (u)
# => lh.z rA, [sp+imm12]
#
:lh.z eregA, ["sp"+imm12] is group=7 & ins0011=0x9d8 ; eregA & imm1616=0 & imm1727
[ imm12 = (imm1727 << 1); ]
{
    local addr:4 = sp + imm12;
    eregA = zext(*:2 addr);
}

#
# rA = h[sp+imm12] (s)
# => lh.s rA, [sp+imm12]
#
:lh.s eregA, ["sp"] is group=7 & ins0011=0x9d9 ; eregA & imm1616=0 & imm1727=0
{
    eregA = sext(*:2 sp);
}

:lh.s eregA, ["sp"+imm12] is group=7 & ins0011=0x9d9 ; eregA & imm1616=0 & imm1727
[ imm12 = (imm1727 << 1); ]
{
    local addr:4 = sp + imm12;
    eregA = sext(*:2 addr);
}

#
# rA = b[sp+imm12] (u)
# => lb.z rA, [sp+imm12]
#
:lb.z eregA, ["sp"+imm1627] is group=7 & ins0011=0x9dc ; eregA & imm1627
{
    local addr:4 = sp + imm1627;
    eregA = zext(*:1 addr);
}