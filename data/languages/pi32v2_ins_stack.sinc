popsregset16: "{psr, sr4}" is imm0005=48 { popreg(sr4); popreg(psr);  }
popsregset16: "{psr, sr4, reti}" is imm0005=49 { popreg(reti); popreg(sr4); popreg(psr);  }
popsregset16: "{psr, sr4, rete}" is imm0005=50 { popreg(rete); popreg(sr4); popreg(psr);  }
