##################
#
# Stack Operations
#
##################

macro pushreg(reg) { mult_addr = mult_addr - 4; *mult_addr = reg; }
macro popreg(reg) { reg = *mult_addr; mult_addr = mult_addr + 4;}


#######################################
# Registers bitmap to register list
#######################################

# Push register based on counter
pshmapreg: "r0" is counter=0 {pushreg(r0);}
pshmapreg: "r1" is counter=1 {pushreg(r1);}
pshmapreg: "r2" is counter=2 {pushreg(r2);}
pshmapreg: "r3" is counter=3 {pushreg(r3);}
pshmapreg: "r4" is counter=4 {pushreg(r4);}
pshmapreg: "r5" is counter=5 {pushreg(r5);}
pshmapreg: "r6" is counter=6 {pushreg(r6);}
pshmapreg: "r7" is counter=7 {pushreg(r7);}
pshmapreg: "r8" is counter=8 {pushreg(r8);}
pshmapreg: "r9" is counter=9 {pushreg(r9);}
pshmapreg: "r10" is counter=10 {pushreg(r10);}
pshmapreg: "r11" is counter=11 {pushreg(r11);}
pshmapreg: "r12" is counter=12 {pushreg(r12);}
pshmapreg: "r13" is counter=13 {pushreg(r13);}
pshmapreg: "r14" is counter=14 {pushreg(r14);}
pshmapreg: "r15" is counter=15 {pushreg(r15);}

# Pop registers based on counter
popmapreg: "r0" is counter=0 {popreg(r0);}
popmapreg: "r1" is counter=1 {popreg(r1);}
popmapreg: "r2" is counter=2 {popreg(r2);}
popmapreg: "r3" is counter=3 {popreg(r3);}
popmapreg: "r4" is counter=4 {popreg(r4);}
popmapreg: "r5" is counter=5 {popreg(r5);}
popmapreg: "r6" is counter=6 {popreg(r6);}
popmapreg: "r7" is counter=7 {popreg(r7);}
popmapreg: "r8" is counter=8 {popreg(r8);}
popmapreg: "r9" is counter=9 {popreg(r9);}
popmapreg: "r10" is counter=10 {popreg(r10);}
popmapreg: "r11" is counter=11 {popreg(r11);}
popmapreg: "r12" is counter=12 {popreg(r12);}
popmapreg: "r13" is counter=13 {popreg(r13);}
popmapreg: "r14" is counter=14 {popreg(r14);}
popmapreg: "r15" is counter=15 {popreg(r15);}

# Pop special registers based on counter
popmapsreg: "reti" is counter=0 {popreg(reti);}
popmapsreg: "rete" is counter=1 {popreg(rete);}
popmapsreg: "retx" is counter=2 {popreg(retx);}
popmapsreg: "rets" is counter=3 {popreg(rets);}
popmapsreg: "sr4" is counter=4 {popreg(sr4);}
popmapsreg: "psr" is counter=5 {popreg(psr);}
popmapsreg: "cnum" is counter=6 {popreg(cnum);}
popmapsreg: "sr7" is counter=7 {popreg(sr7);}
popmapsreg: "sr8" is counter=8 {popreg(sr8);}
popmapsreg: "sr9" is counter=9 {popreg(sr9);}
popmapsreg: "sr10" is counter=10 {popreg(sr10);}
popmapsreg: "icfg" is counter=11 {popreg(icfg);}
popmapsreg: "usp" is counter=12 {popreg(usp);}
popmapsreg: "ssp" is counter=13 {popreg(ssp);}
popmapsreg: "sp" is counter=14 {popreg(sp);}
popmapsreg: "pc" is counter=15 {popreg(pc);}

# Push special registers based on counter
pshmapsreg: "reti" is counter=0 {pushreg(reti);}
pshmapsreg: "rete" is counter=1 {pushreg(rete);}
pshmapsreg: "retx" is counter=2 {pushreg(retx);}
pshmapsreg: "rets" is counter=3 {pushreg(rets);}
pshmapsreg: "sr4" is counter=4 {pushreg(sr4);}
pshmapsreg: "psr" is counter=5 {pushreg(psr);}
pshmapsreg: "cnum" is counter=6 {pushreg(cnum);}
pshmapsreg: "sr7" is counter=7 {pushreg(sr7);}
pshmapsreg: "sr8" is counter=8 {pushreg(sr8);}
pshmapsreg: "sr9" is counter=9 {pushreg(sr9);}
pshmapsreg: "sr10" is counter=10 {pushreg(sr10);}
pshmapsreg: "icfg" is counter=11 {pushreg(icfg);}
pshmapsreg: "usp" is counter=12 {pushreg(usp);}
pshmapsreg: "ssp" is counter=13 {pushreg(ssp);}
pshmapsreg: "sp" is counter=14 {pushreg(sp);}
pshmapsreg: "pc" is counter=15 {pushreg(pc);}

# Bit ops
next: is epsilon [counter=counter+1;]{}
prev: is epsilon [counter=counter-1;]{}
mregread: is imm1631 [bitset=(imm1631 & (1 << counter))>>counter;]{}

pshmreg: pshmapreg is pshmapreg & bitset=1 [sep=1;]{}
pshmreg: is bitset=0 {}
popmreg: popmapreg is popmapreg & bitset=1 [sep=1;]{}
popmreg: is bitset=0 {}
pshmsreg: pshmapsreg is pshmapsreg & bitset=1 [sep=1;]{}
pshmsreg: is bitset=0 {}
popmsreg: popmapsreg is popmapsreg & bitset=1 [sep=1;]{}
popmsreg: is bitset=0 {}
msep: "," is  sep=1 & bitset=1 {}
msep: "" is sep=0 | bitset=0 {}

# Recursively generate our push registers
pshmapregs: pshmapregs^pshmreg^msep is counter<15 & mregread & msep & pshmreg & next & pshmapregs
    { build pshmapregs; build pshmreg; }
pshmapregs: pshmreg is counter=15 & mregread & pshmreg {}
pshmap: pshmapregs is pshmapregs [bitset=0; counter=0; sep=0;] {}


# Recursively generate our pop registers
popmapregs: popmapregs^popmreg^msep is counter<15 & mregread & msep & popmreg & next & popmapregs
    { build popmreg; build popmapregs; }
popmapregs: popmreg is counter=15 & mregread & popmreg {}
popmap: popmapregs is popmapregs [bitset=0; counter=0; sep=0;] {}

# Recursively generate our special registers (for 32-bit instructions)
pshmapsregs: pshmapsregs^pshmsreg^msep is counter<15 & mregread & msep & pshmsreg & next & pshmapsregs
    { build pshmapsregs; build pshmsreg; }
pshmapsregs: pshmsreg is counter=15 & mregread & pshmsreg {}
pshsrmap: pshmapsregs is pshmapsregs [bitset=0; counter=0; sep=0;]{}

popmapsregs: popmapsregs^popmsreg^msep is counter<15 & mregread & msep & popmsreg & next & popmapsregs
    { build popmsreg; build popmapsregs; }
popmapsregs: popmsreg is counter=15 & mregread & popmsreg {}
popsrmap: popmapsregs is popmapsregs [bitset=0; counter=0; sep=0;]{}



#######################################
# Registers boundary to register list
#######################################

rlpshreg: pshmapreg is pshmapreg [sep=1;]{}
rlpopreg: popmapreg is popmapreg [sep=1;]{}

##
# Some variants of push and pop accept a single-byte operand
# specifying a register boundary (upper or lower). The
# following tables are used to generate the corresponding
# registers list and associated p-code.
#
# All these tables use the `counter` context register to
# iterate over the registers, the `sep` context bit to
# indicate when a separator is required and force the
# `bitset` context bit to 1 in order to use the
# `msep` table.
#
# - pushreglist4: push registers from rX to r4 (with X>=4)
# - popreglist4: pop registers from r4 to rX (with X>=4)
# - pushreglist3: push registers from r3 to rX (with X<=3)
# - popreglist3: pop registers from rX to r3 (with X<=3)
# - pushreglist0: push registers from rX to r0 (X>=0)
# - popreglist0: pop registers from r0 to rX (x>=0)
##

pshrl4: msep^rlpshreg^pshrl4 is counter>4 & msep & rlpshreg & prev & pshrl4 
    { build rlpshreg; build pshrl4; }
pshrl4: msep^rlpshreg is counter=4 & msep & rlpshreg {}
pushreglist4: pshrl4 is pshrl4 [sep=0; bitset=1;]{}

# Pop regs from counter to r4
poprl4: msep^rlpopreg^poprl4 is counter>4 & msep & rlpopreg & prev & poprl4 
    {build rlpopreg; build poprl4; }
poprl4: msep^rlpopreg is counter=4 & msep & rlpopreg {}
popreglist4: poprl4 is poprl4 [sep=0; bitset=1; ]{}

# Push regs from counter to r3
pshrl3: pshrl3^rlpshreg^msep is counter<3 & msep & rlpshreg & next & pshrl3 
    {build pshrl3; build rlpshreg;}
pshrl3: rlpshreg^msep is counter=3 & msep & rlpshreg {}
pushreglist3: pshrl3 is pshrl3 [sep=0; bitset=1;]{}

# Pop regs from counter to r0
poprl3: poprl3^rlpopreg^msep is counter<3 & msep & rlpopreg & next & poprl3 
    {build rlpopreg; build poprl3; }
poprl3: rlpopreg^msep is counter=3 & msep & rlpopreg {}
popreglist3: poprl3 is poprl3 [sep=0; bitset=1; ]{}


##
# Some helpers (from @kagaimiq and adapted)
##

# Push rets and then reglist (rX...r4)
pshretsregs: {rets,pushreglist4} is pushreglist4 & rets & ins0003
[ counter=ins0003 & 0x0f; ]
{
    mult_addr = sp;
    pushreg(rets);
    build pushreglist4;
    sp = mult_addr;
}

# Pop reglist (r4...rX) and then pc
poppcregs: {pc,popreglist4} is popreglist4 & pc & ins0003
[counter=ins0003 & 0x0f;]
{
    mult_addr = sp;
    build popreglist4;
    popreg(pc);
    sp = mult_addr;
    return [pc]; 
}

#
# pc = [sp++]
# => pop pc
#
:pop pc is group=0 & ins0012=0x0400 & pc
{
    mult_addr = sp;
	popreg(pc);
    sp = mult_addr;
	return [pc];
}

#
# [--sp] = rets
# => push rets
#
:push rets is group=0 & ins0012=0x0410 & rets
{
    mult_addr = sp;
	pushreg(rets);
    sp = mult_addr;
}




#
# {rets, regs...} = [sp++]
# => pop {rets, regs...}
#
:pop {rets, popreglist4} is group=0 & ins0412=0x043 & ins0003>=4 & ins0003 & popreglist4 & rets
[ counter=ins0003 & 0x0f; ]
{
    mult_addr = sp;
    popreg(rets);
    build popreglist4;
    sp = mult_addr;
}

#
# {regs...} = [sp++]
# => pop {regs...}
#
:pop {popreglist3} is group=0 & ins0412=0x044 & ins0003 & popreglist3
[ counter = ins0003 & 0xf; ]
{
    mult_addr = sp;
    build popreglist3;
    sp = mult_addr;
}

# Pop 16-bit special registers subtable
popsregset16: "{}" is imm0005=0 {  }
popsregset16: "{reti}" is imm0005=1 { popreg(reti);  }
popsregset16: "{rete}" is imm0005=2 { popreg(rete);  }
popsregset16: "{rete, reti}" is imm0005=3 { popreg(reti); popreg(rete);  }
popsregset16: "{retx}" is imm0005=4 { popreg(retx);  }
popsregset16: "{retx, reti}" is imm0005=5 { popreg(reti); popreg(retx);  }
popsregset16: "{retx, rete}" is imm0005=6 { popreg(rete); popreg(retx);  }
popsregset16: "{retx, rete, reti}" is imm0005=7 { popreg(reti); popreg(rete); popreg(retx);  }
popsregset16: "{rets}" is imm0005=8 { popreg(rets);  }
popsregset16: "{rets, reti}" is imm0005=9 { popreg(reti); popreg(rets);  }
popsregset16: "{rets, rete}" is imm0005=10 { popreg(rete); popreg(rets);  }
popsregset16: "{rets, rete, reti}" is imm0005=11 { popreg(reti); popreg(rete); popreg(rets);  }
popsregset16: "{rets, retx}" is imm0005=12 { popreg(retx); popreg(rets);  }
popsregset16: "{rets, retx, reti}" is imm0005=13 { popreg(reti); popreg(retx); popreg(rets);  }
popsregset16: "{rets, retx, rete}" is imm0005=14 { popreg(rete); popreg(retx); popreg(rets);  }
popsregset16: "{rets, retx, rete, reti}" is imm0005=15 { popreg(reti); popreg(rete); popreg(retx); popreg(rets);  }
popsregset16: "{sr4}" is imm0005=16 { popreg(sr4);  }
popsregset16: "{sr4, reti}" is imm0005=17 { popreg(reti); popreg(sr4);  }
popsregset16: "{sr4, rete}" is imm0005=18 { popreg(rete); popreg(sr4);  }
popsregset16: "{sr4, rete, reti}" is imm0005=19 { popreg(reti); popreg(rete); popreg(sr4);  }
popsregset16: "{sr4, retx}" is imm0005=20 { popreg(retx); popreg(sr4);  }
popsregset16: "{sr4, retx, reti}" is imm0005=21 { popreg(reti); popreg(retx); popreg(sr4);  }
popsregset16: "{sr4, retx, rete}" is imm0005=22 { popreg(rete); popreg(retx); popreg(sr4);  }
popsregset16: "{sr4, retx, rete, reti}" is imm0005=23 { popreg(reti); popreg(rete); popreg(retx); popreg(sr4);  }
popsregset16: "{sr4, rets}" is imm0005=24 { popreg(rets); popreg(sr4);  }
popsregset16: "{sr4, rets, reti}" is imm0005=25 { popreg(reti); popreg(rets); popreg(sr4);  }
popsregset16: "{sr4, rets, rete}" is imm0005=26 { popreg(rete); popreg(rets); popreg(sr4);  }
popsregset16: "{sr4, rets, rete, reti}" is imm0005=27 { popreg(reti); popreg(rete); popreg(rets); popreg(sr4);  }
popsregset16: "{sr4, rets, retx}" is imm0005=28 { popreg(retx); popreg(rets); popreg(sr4);  }
popsregset16: "{sr4, rets, retx, reti}" is imm0005=29 { popreg(reti); popreg(retx); popreg(rets); popreg(sr4);  }
popsregset16: "{sr4, rets, retx, rete}" is imm0005=30 { popreg(rete); popreg(retx); popreg(rets); popreg(sr4);  }
popsregset16: "{sr4, rets, retx, rete, reti}" is imm0005=31 { popreg(reti); popreg(rete); popreg(retx); popreg(rets); popreg(sr4);  }
popsregset16: "{psr}" is imm0005=32 { popreg(psr);  }
popsregset16: "{psr, reti}" is imm0005=33 { popreg(reti); popreg(psr);  }
popsregset16: "{psr, rete}" is imm0005=34 { popreg(rete); popreg(psr);  }
